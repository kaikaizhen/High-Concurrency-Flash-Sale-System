{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Cache": {
    "Enabled": true,
    "TtlSeconds": 10,
    "NullTtlSeconds": 3,
    "EnableNullCaching": true,
    "EnableSingleFlight": true
  },
  "RateLimit": {
    "Enabled": true,
    "PerIp": {
      "Enabled": true,
      "PermitLimit": 600,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "FlashSale": {
      "Enabled": true,
      "Algorithm": "SlidingWindow",
      "PermitLimit": 10,
      "WindowSeconds": 1,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    }
  },
  "Idempotency": {
    "Enabled": true,
    "Provider": "Redis",
    "TtlSeconds": 86400,
    "Required": false
  },
  "SharedState": {
    "DistributedMetrics": true,
    "DistributedLock": true,
    "DistributedRateLimit": true
  },
  "RabbitMq": {
    "Enabled": true,
    "VirtualHost": "/",
    "MaxRetryCount": 3,
    "RetryDelayMs": 5000
  },
  "Redis": {
    "InstanceName": "flashsale:",
    "ConnectTimeoutMs": 5000
  }
}
