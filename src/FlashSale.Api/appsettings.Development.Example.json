{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=<db-host>;Database=<db-name>;User Id=<db-user>;Password=<db-password>;TrustServerCertificate=True;"
  },
  "Redis": {
    "Configuration": "<redis-host>:<redis-port>",
    "User": "<redis-user>",
    "Password": "<redis-password>",
    "InstanceName": "flashsale:",
    "ConnectTimeoutMs": 5000
  },
  "Cache": {
    "Enabled": true,
    "TtlSeconds": 10,
    "NullTtlSeconds": 3,
    "EnableNullCaching": true,
    "EnableSingleFlight": true
  },
  "RabbitMq": {
    "HostName": "<rabbitmq-host>",
    "Port": 5672,
    "UserName": "<rabbitmq-user>",
    "Password": "<rabbitmq-password>",
    "VirtualHost": "/",
    "Enabled": true,
    "MaxRetryCount": 3,
    "RetryDelayMs": 5000
  },
  "Idempotency": {
    "Enabled": true,
    "Provider": "Redis",
    "TtlSeconds": 86400,
    "Required": false
  },
  "Worker": {
    "PrefetchCount": 1,
    "SimulatedProcessingMs": 0
  }
}
