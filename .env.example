# docker-compose 用的連線設定。
#
# 複製成 .env 後填入實際值。.env 已被 gitignore，不會進版控。
#
#     cp .env.example .env
#
# 注意容器內看不到 localhost —— 若相依服務跑在 Docker 主機上，
# 位址要用 host.docker.internal（Windows / macOS）。

DB_CONNECTION=Server=<db-host>;Database=<db-name>;User Id=<db-user>;Password=<db-password>;TrustServerCertificate=True;

REDIS_CONFIGURATION=<redis-host>:6379
REDIS_USER=
REDIS_PASSWORD=

RABBITMQ_HOST=<rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_USER=<rabbitmq-user>
RABBITMQ_PASSWORD=<rabbitmq-password>

# Stage 8 對照組開關（正式環境三個都應該是 true）
SHARED_METRICS=true
SHARED_LOCK=true
SHARED_RATELIMIT=true
